# ==================================
# Postgres
# ==================================
# Superuser for docker init (creates OLTP/MART/Airflow DBs and roles)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Legacy single DB alias, kept for backward compat when OLTP/MART not split
POSTGRES_DATABASE=freight_lake
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=changeme

# FreightLake split databases per diagram PG_OLTP and PG_MART
# Init script docker/init/01_create_database.sql creates these three DBs
POSTGRES_OLTP_DATABASE=freightlake_oltp
POSTGRES_OLTP_USER=freightlake_oltp_user
POSTGRES_OLTP_PASSWORD=changeme
POSTGRES_MART_DATABASE=freightlake_mart
POSTGRES_MART_USER=freightlake_mart_user
POSTGRES_MART_PASSWORD=changeme
POSTGRES_AIRFLOW_DATABASE=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=admin

# Optional for managed cloud Postgres like Neon
# POSTGRES_SSLMODE=require
# POSTGRES_CHANNEL_BINDING=require

# Bronze / silver / gold schemas when using the medallion layout in Postgres
# POSTGRES_SCHEMA_BRONZE=bronze
# POSTGRES_SCHEMA_SILVER=silver
# POSTGRES_SCHEMA_GOLD=gold

# ==================================
# MongoDB
# ==================================
MONGO_URI=mongodb://localhost:27017
MONGO_DB=freight_lake

# ==================================
# Databricks Connection
# ==================================
# Host for Unity Catalog REST API.
#   For Databricks workspaces use the workspace host, e.g. dbc-xxxx.cloud.databricks.com
#   For local OSS Unity Catalog use http://localhost:8080/api/2.1/unity-catalog
DATABRICKS_HOST=dbc-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXX
DATABRICKS_CATALOG=freightlake
DATABRICKS_SCHEMA=bronze

# ==================================
# Bronze Write Strategy
# ==================================
# Databricks managed tables (CATALOG_DB_STORAGE) cannot be created or written
# from outside Databricks compute. Direct UCSingleCatalog staged writes will
# fail with 403 ErrorCode 5108 createStagingTable and 5105 getTableCredentials
# plus UNITY_CATALOG_EXTERNAL_CREATE_TABLE_REQUEST_FOR_NON_EXTERNAL_TABLE_DENIED.
#
# Pick one of:
#   warehouse   -> use Databricks SQL warehouse via databricks-sql-connector
#                (default, works from outside, verified with freightlake.bronze)
#   local       -> write Delta to local filesystem under BRONZE_LOCAL_PATH
#                (no UC, for offline dev, writes to ./spark-warehouse/bronze)
#   uc_managed  -> direct Unity Catalog managed writes via UCSingleCatalog
#                (only inside Databricks compute/cluster)
#   uc_external -> Unity Catalog external tables via DATABRICKS_EXTERNAL_LOCATION
#                (requires external location + storage credential)
#
# Use --write-mode CLI flag to override this env var per run:
#   python -m src.jobs.pg_extract_incremental --write-mode warehouse --table orders
#   python -m src.jobs.pg_extract_incremental --write-mode local --dry-run
BRONZE_WRITE_MODE=warehouse
BRONZE_LOCAL_PATH=./spark-warehouse/bronze

# Only needed for uc_external mode:
# Must be an external location already created in Unity Catalog, e.g.
#   CREATE EXTERNAL LOCATION freightlake_bronze LOCATION 's3://my-bucket/freightlake/bronze' WITH CREDENTIAL my_cred;
# Then grant CREATE EXTERNAL TABLE on schema freightlake.bronze to your principal.
# DATABRICKS_EXTERNAL_LOCATION=s3://my-bucket/freightlake/bronze
# DATABRICKS_EXTERNAL_BASE_PATH=s3://my-bucket/freightlake/bronze

# ==================================
# PySpark
# ==================================
# PYSPARK_PYTHON=python
# PYSPARK_DRIVER_PYTHON=python
