# FreightLake — environment template
#
# Copy this file to .env and fill in real values. Never commit the real .env
# file, only this template. Every value below is a placeholder, not a
# credential, safe to commit.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
ENVIRONMENT=local
LOG_LEVEL=INFO
TZ=UTC

# ---------------------------------------------------------------------------
# PostgreSQL — one container, three logical databases
# ---------------------------------------------------------------------------

# Superuser, used only by setup scripts to create the databases and roles below
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme

# OLTP database — the simulated ERP source (customers, drivers, trucks,
# trailers, facilities, routes, loads, trips, fuel purchases)
POSTGRES_OLTP_DB=freightlake_oltp
POSTGRES_OLTP_USER=freightlake_oltp_user
POSTGRES_OLTP_PASSWORD=changeme
POSTGRES_OLTP_URL=postgresql://freightlake_oltp_user:changeme@localhost:55432/freightlake_oltp
# Host port for postgres container — 55432 avoids Windows Hyper-V excluded 5433-5532
# and host 5432 collision (local Postgres). Override with env if needed.
POSTGRES_DOCKER_PORT=55432

# Serving mart database — the gold layer publish target, what Power BI would
# connect to
POSTGRES_MART_DB=freightlake_mart
POSTGRES_MART_USER=freightlake_mart_user
POSTGRES_MART_PASSWORD=changeme
POSTGRES_MART_URL=postgresql://freightlake_mart_user:changeme@localhost:55432/freightlake_mart

# Airflow metadata database — internal to Airflow, do not point application
# code at this one
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=changeme

# ---------------------------------------------------------------------------
# MongoDB — the simulated tracking feed (delivery events, safety incidents,
# maintenance records)
# ---------------------------------------------------------------------------
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_DB=freightlake_tracking
MONGO_URI=mongodb://root:changeme@localhost:27017/freightlake_tracking?authSource=admin

# ---------------------------------------------------------------------------
# Databricks — the lakehouse, bronze plus silver plus gold
# ---------------------------------------------------------------------------
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=dapi_replace_with_a_real_token
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<warehouse_id>
DATABRICKS_CATALOG=freightlake
DATABRICKS_SCHEMA_BRONZE=bronze
DATABRICKS_SCHEMA_SILVER=silver
DATABRICKS_SCHEMA_GOLD=gold

# ---------------------------------------------------------------------------
# dbt
# ---------------------------------------------------------------------------
DBT_PROFILES_DIR=./dbt
DBT_TARGET=dev

# ---------------------------------------------------------------------------
# Airflow
# ---------------------------------------------------------------------------
# LocalExecutor is enough here, the compose file only runs webserver,
# scheduler, and dag-processor, no separate worker or broker needed
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=replace_with_a_generated_fernet_key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=replace_with_a_random_secret
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Moved off 8080 to avoid the port collision with docker-environment-manager
# noted in AGENTS.md
AIRFLOW_WEBSERVER_PORT=8090

# ---------------------------------------------------------------------------
# Great Expectations
# ---------------------------------------------------------------------------
GE_DATA_CONTEXT_ROOT=./great_expectations
