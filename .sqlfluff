[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 120
rules = all
exclude_rules = LT01,LT02,LT05,LT08,LT09,RF04,ST06,RF02,LT04,CP01,CP03,CV11,AL01,AM04

[sqlfluff:layout:type:comma]
line_position = trailing

[sqlfluff:indentation]
indent_unit = space
tab_space_size = 4
indent_width = 4
